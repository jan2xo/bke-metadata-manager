<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bke.MetadataManager.MainWindow" Width="1100" Height="720" MinWidth="820" MinHeight="560" Title="BKE Metadata Manager — MVP 0.1.0">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="20" Background="#182638">
      <StackPanel Spacing="4"><TextBlock Text="BKE METADATA MANAGER" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock Text="Offline-first • Non-destructive • Reversible" Foreground="#B8C8D8"/></StackPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="#F2F5F8" Padding="14">
      <StackPanel Spacing="10">
        <TextBlock Text="WORKSPACE" FontWeight="Bold" Foreground="#506174"/>
        <Button Content="Import Queue" HorizontalContentAlignment="Left"/><Button Content="Asset Browser" HorizontalContentAlignment="Left"/>
        <Button Content="Metadata Editor" HorizontalContentAlignment="Left"/><Button Content="Filename Preview" HorizontalContentAlignment="Left"/>
        <Button Content="Duplicate Review" HorizontalContentAlignment="Left"/><Button Content="Revision History" HorizontalContentAlignment="Left"/>
        <Separator/><TextBlock Text="Safety rules" FontWeight="Bold"/>
        <TextBlock Text="• Never transcode media&#10;• Never overwrite files&#10;• Hash original bytes&#10;• Preserve before editing" TextWrapping="Wrap" Foreground="#425466"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="28" Spacing="18">
        <TextBlock Text="Import and inspect assets" FontSize="26" FontWeight="SemiBold"/>
        <Border BorderBrush="#91A5B8" BorderThickness="2" CornerRadius="10" Padding="24" Background="#F8FAFC">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="Import files or recursively scan folders" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Files are read-only fingerprinted with SHA-256. Media bytes are never modified." TextWrapping="Wrap" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <Button Content="Choose files…" Click="ChooseFiles_Click"/><Button Content="Choose folders…" Click="ChooseFolders_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="2*,*,*,*" Background="#E8EEF4" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="Filename / path" FontWeight="Bold" Margin="8"/><TextBlock Grid.Column="1" Text="Size" FontWeight="Bold" Margin="8"/>
          <TextBlock Grid.Column="2" Text="SHA-256" FontWeight="Bold" Margin="8"/><TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" Margin="8"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Assets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#D5DEE7" BorderThickness="0,0,0,1" Padding="8">
                <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="3"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Path}" FontSize="11" Foreground="#65788A" TextWrapping="Wrap"/></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Sha256}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Metadata editing, rename commits, and rollback remain disabled until the recoverable commit engine is implemented." TextWrapping="Wrap" Foreground="#8A4B12"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
