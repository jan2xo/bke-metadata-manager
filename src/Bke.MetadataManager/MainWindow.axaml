<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bke.MetadataManager.MainWindow" Width="1100" Height="720" MinWidth="820" MinHeight="560" Title="BKE Metadata Manager — MVP 0.1.0">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="20" Background="#182638">
      <StackPanel Spacing="4"><TextBlock Text="BKE METADATA MANAGER" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock Text="Offline-first • Non-destructive • Reversible" Foreground="#B8C8D8"/></StackPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="#F2F5F8" Padding="14">
      <StackPanel Spacing="10">
        <TextBlock Text="WORKSPACE" FontWeight="Bold" Foreground="#506174"/>
        <Button Content="Import Queue" HorizontalContentAlignment="Left"/><Button Content="Asset Browser" HorizontalContentAlignment="Left"/>
        <Button Content="Metadata Editor" HorizontalContentAlignment="Left"/><Button Content="Filename Preview" HorizontalContentAlignment="Left"/>
        <Button Content="Duplicate Review" HorizontalContentAlignment="Left"/><Button Content="Revision History" HorizontalContentAlignment="Left"/>
        <Separator/><TextBlock Text="Safety rules" FontWeight="Bold"/>
        <TextBlock Text="• Never transcode media&#10;• Never overwrite files&#10;• Hash original bytes&#10;• Preserve before editing" TextWrapping="Wrap" Foreground="#425466"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="28" Spacing="18">
        <TextBlock Text="Import and inspect assets" FontSize="26" FontWeight="SemiBold"/>
        <Border BorderBrush="#91A5B8" BorderThickness="2" CornerRadius="10" Padding="28" Background="#F8FAFC">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="Drop media files or folders here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Recursive folder scanning and import queue are next integration steps." TextWrapping="Wrap" HorizontalAlignment="Center"/>
            <Button Content="Choose files…" HorizontalAlignment="Center" IsEnabled="False"/>
          </StackPanel>
        </Border>
        <TextBlock Text="MVP foundation" FontSize="18" FontWeight="SemiBold"/>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
          <Border Grid.Row="0" Grid.Column="0" BorderBrush="#D5DEE7" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="6"><TextBlock Text="SHA-256 identity" FontWeight="Bold"/><TextBlock Text="Deterministic full-file fingerprinting; filename-independent duplicate checks." TextWrapping="Wrap"/></StackPanel></Border>
          <Border Grid.Row="0" Grid.Column="1" BorderBrush="#D5DEE7" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Safe naming" FontWeight="Bold"/><TextBlock Text="Sanitized names, sequence formatting, and no-overwrite collision checks." TextWrapping="Wrap"/></StackPanel></Border>
          <Border Grid.Row="1" Grid.Column="0" BorderBrush="#D5DEE7" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="6"><TextBlock Text="Metadata reader" FontWeight="Bold"/><TextBlock Text="Offline ExifTool JSON reader; writes intentionally not enabled yet." TextWrapping="Wrap"/></StackPanel></Border>
          <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D5DEE7" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="6"><TextBlock Text="SQLite journal" FontWeight="Bold"/><TextBlock Text="Catalog schema for original fingerprints, snapshots, revisions, and operations." TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>
        <TextBlock Text="Early scaffold, not yet a release-ready metadata editor. Embedded writes remain disabled until backup, commit, verification, and rollback are implemented and tested." TextWrapping="Wrap" Foreground="#8A4B12"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
